# LLM 配置
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MAX_TOKENS_PER_REQUEST=4096
OPENAI_TEMPERATURE=0.7

# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# SQLite 数据库路径
SQLITE_DB_PATH=./data/cfa_agent.db

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE=./logs/cfa_agent.log

# 行为护栏配置
BEHAVIOR_MAX_STEPS=20
BEHAVIOR_TOKEN_BUDGET=50000
BEHAVIOR_DEVIATION_THRESHOLD=0.6
BEHAVIOR_CONSECUTIVE_DEVIATION_LIMIT=5